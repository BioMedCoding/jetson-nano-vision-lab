# Each part (camera/, nano/, training/) has its own .gitignore for its
# specific build products. This file only covers repo-wide cruft.
.DS_Store
*~
.venv/
venv/
__pycache__/
*.pyc

# Local, per-user configuration (see host/jetson.env.example)
host/jetson.env

# Large files are stored in git as verified chunks (see tools/largefiles.py);
# the reassembled originals are build products and never committed.
*.joined

