# Copy to host/jetson.env and adjust. Read by the scripts in host/.
# (host/jetson.env is git-ignored: it is your local setup, not the repo's.)

# ssh destination of the Jetson: an ~/.ssh/config alias, user@ip, or user@hostname.local
JETSON_HOST=jetson

# Where the repo's nano/ part lives on the Jetson
JETSON_DIR='~/jetson-nano-vision-lab'
