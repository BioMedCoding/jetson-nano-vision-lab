# Build artifacts produced by scripts/build.sh running directly inside
# source/public/kernel/kernel-4.9 — none of this is source, all of it is
# regenerated by a build. Kept broad on purpose: rather safe than have a
# rebuild silently dirty the tree with hundreds of MB of binaries.

# Object / module build products
*.o
*.o.*
*.ko
*.ko.*
*.mod
*.mod.c
*.mod.o
*.cmd
.tmp_versions/
.*.d
*.a
*.s
*.i
*.symtypes
*.order
modules.order
modules.builtin*
Module.symvers

# Compiled device trees (source .dts/.dtsi stay tracked, output .dtb doesn't)
*.dtb
*.dtbo
arch/arm64/boot/dts/_ddot_/

# Kernel image outputs
arch/arm64/boot/Image
arch/arm64/boot/zImage
arch/*/kernel/vdso/vdso.so*
arch/*/kernel/vdso/vdso.lds
vmlinux
vmlinux.o
System.map
.tmp_System.map
.tmp_kallsyms*
.tmp_vmlinux*
.version
.missing-syscalls.d

# Generated headers / config
include/config/
include/generated/
kernel/config_data.gz
kernel/config_data.h
lib/crc32table.h
lib/gen_crc32table

# Kconfig state: the shipped config/nano-ov5647.config is the tracked
# reference; a .config inside the tree is always local build state.
source/public/kernel/kernel-4.9/.config
source/public/kernel/kernel-4.9/.config.old
source/public/kernel/kernel-4.9/.config.cmd

# Compiled host tools (regenerated from tracked sources on first build)
scripts/basic/fixdep
scripts/basic/bin2c
scripts/kconfig/conf
scripts/kconfig/zconf.tab.c
scripts/kconfig/zconf.lex.c
scripts/kconfig/zconf.hash.c
scripts/genksyms/genksyms
scripts/genksyms/*.hash.c
scripts/genksyms/lex.lex.c
scripts/genksyms/parse.tab.c
scripts/genksyms/parse.tab.h
scripts/mod/modpost
scripts/mod/mk_elfconfig
scripts/mod/elfconfig.h
scripts/mod/devicetable-offsets.h
scripts/dtc/dtc
scripts/dtc/dtc-lexer.lex.c
scripts/dtc/dtc-parser.tab.c
scripts/dtc/dtc-parser.tab.h
scripts/conmakehash
scripts/kallsyms
scripts/pnmtologo
scripts/recordmcount
scripts/sortextable

# Generated firmware / logo / keymap / raid6 tables (built on demand,
# unrelated to Tegra or the camera — upstream ships them as generated too)
firmware/*.bin
firmware/*.gen.S
firmware/ihex2fw
drivers/tty/vt/consolemap_deftbl.c
drivers/tty/vt/defkeymap.c
drivers/video/logo/logo_*.c
drivers/video/logo/clut_vga16.c
lib/raid6/int*.c
lib/raid6/neon*.c
lib/raid6/tables.c
lib/raid6/mktables

# initramfs staging
usr/gen_init_cpio
usr/initramfs_data.cpio.gz
usr/.initramfs_data.cpio.d

# Module signing (not used by this build)
certs/signing_key*
certs/x509.genkey

# Editor / OS cruft
*~
.DS_Store

# prebuilt/ is the one place where build OUTPUTS are deliberately tracked:
# verified-on-hardware binaries, so the camera can be used without building.
!prebuilt/**

# Python bytecode e output di runtime degli script cv/
__pycache__/
*.pyc
cv/cv_projects/01_camera_test/snapshots/
cv/cv_projects/05_dataset_capture/dataset/
