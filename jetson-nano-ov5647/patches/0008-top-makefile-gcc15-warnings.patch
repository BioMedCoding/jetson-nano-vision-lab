--- a/kernel/kernel-4.9/Makefile
+++ b/kernel/kernel-4.9/Makefile
@@ -685,6 +685,21 @@
 KBUILD_CFLAGS	+= $(call cc-disable-warning, attribute-alias)
 KBUILD_CFLAGS   += $(call cc-disable-warning, address-of-packed-member)
 KBUILD_CFLAGS   += $(call cc-disable-warning, packed-not-aligned)
+# This kernel predates GCC's newer, stricter default diagnostics; downgrade
+# them back to warnings instead of patching every third-party vendor driver
+# that trips them (same rationale as the -Werror relaxations above).
+KBUILD_CFLAGS   += $(call cc-disable-warning, address)
+KBUILD_CFLAGS   += $(call cc-disable-warning, misleading-indentation)
+KBUILD_CFLAGS   += $(call cc-disable-warning, stringop-overread)
+KBUILD_CFLAGS   += $(call cc-disable-warning, stringop-overflow)
+KBUILD_CFLAGS   += $(call cc-disable-warning, header-guard)
+KBUILD_CFLAGS   += $(call cc-disable-warning, compare-distinct-pointer-types)
+KBUILD_CFLAGS   += $(call cc-disable-warning, dangling-pointer)
+KBUILD_CFLAGS   += $(call cc-disable-warning, use-after-free)
+KBUILD_CFLAGS   += $(call cc-disable-warning, calloc-transposed-args)
+KBUILD_CFLAGS   += $(call cc-disable-warning, enum-int-mismatch)
+KBUILD_CFLAGS   += $(call cc-disable-warning, tautological-compare)
+KBUILD_CFLAGS   += $(call cc-disable-warning, array-parameter)
 
 ifdef CONFIG_LD_DEAD_CODE_DATA_ELIMINATION
 KBUILD_CFLAGS	+= $(call cc-option,-ffunction-sections,)
