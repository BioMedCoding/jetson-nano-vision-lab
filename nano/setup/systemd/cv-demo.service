[Unit]
Description=Jetson Nano CV demo (YOLOv5 TensorRT dashboard)
After=network-online.target nvargus-daemon.service
Wants=network-online.target
# NOTA: niente dipendenza da un'unit dev-video0.device: verificato che questo
# sistema non ne genera una per la camera CSI fissa (systemctl list-units
# --all | grep video0 non la trova). La riconnessione della camera e' gestita
# a livello applicativo in demo_server.py (classe CameraSource, backoff+retry).

[Service]
Type=simple
User=matteo
WorkingDirectory=/home/matteo/cv_projects
ExecStart=/home/matteo/cv_projects/venv/bin/python3 \
    /home/matteo/cv_projects/03_tensorrt/demo_server.py \
    --engine /home/matteo/cv_projects/models/yolov5n_416_fp16.engine --headless
Restart=always
RestartSec=3
# I due workaround dell'attivazione venv (setup_jetson.sh) NON fanno parte
# del venv stesso: senza queste due righe il servizio crasha/rallenta per gli
# stessi bug noti in SETUP_GUIDE.md ("Illegal instruction" OpenBLAS, "cannot
# allocate memory in static TLS block" cv2-dopo-torch).
Environment=OPENBLAS_CORETYPE=ARMV8
Environment=LD_PRELOAD=/usr/lib/aarch64-linux-gnu/libgomp.so.1

[Install]
WantedBy=multi-user.target
