# Python environment (recreated by setup/setup_host.sh)
.venv/
__pycache__/
*.pyc

# Training outputs: regenerable. The pretrained STARTING weights in
# weights/ are vendored on purpose (release download links rot), so they
# are re-included below.
*.pt
*.onnx
*.engine
*.pth
!weights/*.pt
runs/
export/
vendor/yolov5/runs/
vendor/yolov7/runs/
*.cache

# Datasets: large and yours (datasets/cache is rebuilt by the NNI pipeline,
# datasets/local_capture holds your labelled Nano captures)
datasets/
